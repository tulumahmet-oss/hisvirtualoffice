{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/chat/messages",
      "destination": "/api/chat-messages"
    },
    {
      "source": "/auth/google",
      "destination": "/api/auth-google"
    },
    {
      "source": "/auth/google/callback",
      "destination": "/api/auth-google-callback"
    }
  ]
}
