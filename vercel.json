{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/server/api/login"
    },
    {
      "source": "/api/me",
      "destination": "/api/server/api/me"
    },
    {
      "source": "/api/logout",
      "destination": "/api/server/api/logout"
    },
    {
      "source": "/api/profile",
      "destination": "/api/server/api/profile"
    },
    {
      "source": "/api/chat/messages",
      "destination": "/api/server/api/chat/messages"
    },
    {
      "source": "/auth/google",
      "destination": "/api/server/auth/google"
    },
    {
      "source": "/auth/google/callback",
      "destination": "/api/server/auth/google/callback"
    },
    {
      "source": "/vendor/three/:path*",
      "destination": "/api/server/vendor/three/:path*"
    },
    {
      "source": "/office-3d.js",
      "destination": "/api/server/office-3d.js"
    },
    {
      "source": "/map-layout.js",
      "destination": "/api/server/map-layout.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/server/assets/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "/api/server/socket.io/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/server/:path*"
    }
  ]
}
